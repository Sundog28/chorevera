# Production-only example.
# Never commit real secret values.

ENVIRONMENT=production

# Render injects DATABASE_URL automatically from Render Postgres.
# DATABASE_URL=postgresql://...

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ISSUER=choreflow-api
JWT_AUDIENCE=choreflow-web
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Replace with the exact deployed frontend origin.
FRONTEND_URL=https://YOUR-FRONTEND.onrender.com
CORS_ALLOWED_ORIGINS_CSV=https://YOUR-FRONTEND.onrender.com

# The production config automatically adds Render's exact
# RENDER_EXTERNAL_HOSTNAME to trusted hosts.
TRUSTED_HOSTS_CSV=localhost,127.0.0.1,testserver

# Render terminates TLS at its edge. Keep this false on Render.
FORCE_HTTPS=false
TRUST_PROXY_HEADERS=true
DOCS_ENABLED=false
RATE_LIMIT_ENABLED=true

AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_RATE_WINDOW_SECONDS=60
AUTH_SENSITIVE_RATE_LIMIT=5
AUTH_SENSITIVE_RATE_WINDOW_SECONDS=300

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=300

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=ChoreFlow <noreply@example.com>
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_FAMILY_PRICE_ID=
STRIPE_CHECKOUT_SUCCESS_URL=https://YOUR-FRONTEND.onrender.com/?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=https://YOUR-FRONTEND.onrender.com/?checkout=cancelled
STRIPE_PORTAL_RETURN_URL=https://YOUR-FRONTEND.onrender.com/
